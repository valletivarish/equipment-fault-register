[Unit]
Description=Equipment fault register API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=faultreg
WorkingDirectory=/opt/fault-register/current/backend
EnvironmentFile=/etc/fault-register.env
EnvironmentFile=/opt/fault-register/current/release.env
# One worker is enough for this workload on a t3.micro and keeps memory low.
ExecStart=/opt/fault-register/current/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
